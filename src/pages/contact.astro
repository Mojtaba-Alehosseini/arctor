---
import Base from "../layouts/Base.astro";
import ContactContent from "../components/ContactContent.astro";
import { DEFAULT_LOCALE, t } from "../i18n/config";

const locale = DEFAULT_LOCALE;
const d = t(locale);
---

<Base
  locale={locale}
  pathname="/contact"
  title={`${d.contact.eyebrow} — ${d.meta.title}`}
  description={d.contact.body}
>
  <ContactContent locale={locale} />
</Base>
