---
import Base from "../../layouts/Base.astro";
import ProjectDetail from "../../components/ProjectDetail.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import { projects, projectCopy } from "../../data/projects";
import { DEFAULT_LOCALE } from "../../i18n/config";

export function getStaticPaths() {
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const locale = DEFAULT_LOCALE;
const c = projectCopy(project.slug, locale);
---

<Base
  locale={locale}
  pathname={`/work/${project.slug}`}
  title={`${c.title} — Shirin Keshmirinejad`}
  description={c.brief}
  ogImage={`/images/${project.slug}/${project.cover.src}`}
>
  <ProjectDetail locale={locale} project={project} />
  <CtaBlock locale={locale} />
</Base>
