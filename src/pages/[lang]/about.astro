---
import Base from "../../layouts/Base.astro";
import AboutContent from "../../components/AboutContent.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import { LOCALES, DEFAULT_LOCALE, t, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base
  locale={locale}
  pathname="/about"
  title={`${d.about.eyebrow} — ${d.meta.title}`}
  description={d.about.lead}
  ogImage="/portrait.jpg"
>
  <AboutContent locale={locale} />
  <CtaBlock locale={locale} />
</Base>
