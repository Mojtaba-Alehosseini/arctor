---
import Base from "../../layouts/Base.astro";
import ServicesContent from "../../components/ServicesContent.astro";
import CtaBlock from "../../components/CtaBlock.astro";
import { LOCALES, DEFAULT_LOCALE, t, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base
  locale={locale}
  pathname="/services"
  title={`${d.practice.eyebrow} — ${d.meta.title}`}
  description={d.practice.lead}
>
  <ServicesContent locale={locale} />
  <CtaBlock locale={locale} />
</Base>
