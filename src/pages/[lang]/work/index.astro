---
import Base from "../../../layouts/Base.astro";
import WorkGallery from "../../../components/WorkGallery.astro";
import CtaBlock from "../../../components/CtaBlock.astro";
import { LOCALES, DEFAULT_LOCALE, t, type Locale } from "../../../i18n/config";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base
  locale={locale}
  pathname="/work"
  title={`${d.work.eyebrow} — ${d.meta.title}`}
  description={d.work.lead}
>
  <WorkGallery locale={locale} />
  <CtaBlock locale={locale} />
</Base>
