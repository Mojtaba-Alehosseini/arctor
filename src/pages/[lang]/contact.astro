---
import Base from "../../layouts/Base.astro";
import ContactContent from "../../components/ContactContent.astro";
import { LOCALES, DEFAULT_LOCALE, t, type Locale } from "../../i18n/config";

export function getStaticPaths() {
  return LOCALES.filter((l) => l !== DEFAULT_LOCALE).map((lang) => ({ params: { lang } }));
}

const locale = Astro.params.lang as Locale;
const d = t(locale);
---

<Base
  locale={locale}
  pathname="/contact"
  title={`${d.contact.eyebrow} — ${d.meta.title}`}
  description={d.contact.body}
>
  <ContactContent locale={locale} />
</Base>
