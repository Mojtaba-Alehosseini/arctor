---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import Manifesto from "../components/Manifesto.astro";
import Thesis from "../components/Thesis.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import Capabilities from "../components/Capabilities.astro";
import Brands from "../components/Brands.astro";
import CtaBlock from "../components/CtaBlock.astro";

const locale = "en" as const;
---

<Base locale={locale} pathname="/">
  <Hero locale={locale} />
  <Manifesto locale={locale} />
  <Thesis locale={locale} />
  <FeaturedWork locale={locale} />
  <Capabilities locale={locale} />
  <Brands locale={locale} />
  <CtaBlock locale={locale} />
</Base>
