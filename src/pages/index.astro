---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import WorkIndex from "../components/WorkIndex.astro";
import Numbers from "../components/Numbers.astro";
import Thesis from "../components/Thesis.astro";
import FeaturedWork from "../components/FeaturedWork.astro";
import Brands from "../components/Brands.astro";
import CtaBlock from "../components/CtaBlock.astro";
import { DEFAULT_LOCALE } from "../i18n/config";

const locale = DEFAULT_LOCALE;
---

<Base locale={locale} pathname="/">
  <Hero locale={locale} />
  <WorkIndex locale={locale} />
  <Numbers locale={locale} />
  <Thesis locale={locale} />
  <FeaturedWork locale={locale} />
  <Brands locale={locale} />
  <CtaBlock locale={locale} />
</Base>
