---
import AirflowDiagram from "./AirflowDiagram.astro";
import Mark from "./Mark.astro";
import { t, localePath, type Locale } from "../i18n/config";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="on-dark grain relative overflow-hidden">
  <div class="shell band">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-5" data-reveal>
        <p class="label reveal" style="opacity:.62">{d.thesis.eyebrow}</p>
        <div class="reveal mt-7 flex items-start gap-5" style="--d:60ms">
          <Mark slug="house-of-future" class="mt-1 hidden h-14 w-14 shrink-0 sm:block" style="color:var(--accent)" />
          <h2 class="t-h2">{d.thesis.title}</h2>
        </div>
        <p class="t-lead reveal mt-6" style="--d:110ms;color:var(--accent)">{d.thesis.lead}</p>
        <p class="t-body reveal measure mt-6" style="--d:150ms">{d.thesis.body}</p>

        <div class="rule-t reveal mt-10 flex items-end gap-6 pt-7" style="--d:200ms">
          <p class="font-display text-[clamp(2.6rem,5vw,4rem)] leading-none" style="color:var(--accent)">
            {d.thesis.statValue}
          </p>
          <p class="label measure-sm pb-2" style="opacity:.62">{d.thesis.statLabel}</p>
        </div>

        <div class="reveal mt-9" style="--d:250ms">
          <a class="btn" href={localePath(locale, "/work/house-of-future/")}>
            {d.thesis.cta}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <div class="lg:col-span-7" data-reveal>
        <p class="label mb-8" style="opacity:.62">{d.thesis.diagram.title}</p>
        <div class="reveal" style="--d:120ms">
          <AirflowDiagram locale={locale} />
        </div>
      </div>
    </div>
  </div>
</section>
