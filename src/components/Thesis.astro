---
import { t, type Locale, localePath } from "../i18n/config";
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="relative bg-[var(--color-ink)] text-[var(--color-travertine)] overflow-hidden">
  <div class="container-edge py-32 sm:py-44 grid grid-cols-1 md:grid-cols-12 gap-12 md:gap-16 items-center">
    <div class="md:col-span-6 reveal-trigger">
      <p class="text-eyebrow opacity-60 mb-6">{dict.thesis.eyebrow} — 03 / 06</p>
      <h2 class="text-display text-[clamp(1.8rem,4vw,3.2rem)] leading-[1.08] mb-8">
        <span class="reveal-mask block"><span class="reveal-line">{dict.thesis.title}</span></span>
      </h2>
      <p class="text-base sm:text-lg opacity-80 leading-relaxed max-w-[60ch] mb-6">{dict.thesis.body}</p>
      <p class="text-eyebrow opacity-60 mb-8">{dict.thesis.tutors}</p>
      <a href={localePath(locale, "work/windcatcher-thesis")} class="inline-flex items-center gap-3 text-eyebrow link-underline">
        <span>{dict.thesis.cta}</span><span aria-hidden="true">→</span>
      </a>
    </div>

    <!-- decorative windcatcher diagram -->
    <div class="md:col-span-6 aspect-[3/4] relative mx-auto w-full max-w-[440px]" aria-hidden="true">
      <svg viewBox="0 0 300 400" class="w-full h-full" xmlns="http://www.w3.org/2000/svg" fill="none">
        <defs>
          <linearGradient id="gradWC" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="rgba(244,239,230,0.0)" />
            <stop offset="1" stop-color="rgba(244,239,230,0.07)" />
          </linearGradient>
        </defs>

        <!-- ground -->
        <line x1="0" y1="370" x2="300" y2="370" stroke="rgba(244,239,230,0.4)" stroke-width="0.6" />

        <!-- building body -->
        <rect x="80" y="240" width="140" height="130" stroke="rgba(244,239,230,0.5)" stroke-width="0.8" fill="url(#gradWC)" />

        <!-- arches openings -->
        <path d="M100 370 v-40 a18 18 0 0 1 36 0 v40" stroke="rgba(244,239,230,0.45)" stroke-width="0.8" />
        <path d="M164 370 v-40 a18 18 0 0 1 36 0 v40" stroke="rgba(244,239,230,0.45)" stroke-width="0.8" />

        <!-- windcatcher tower -->
        <rect x="115" y="80" width="70" height="170" stroke="rgba(244,239,230,0.65)" stroke-width="0.8" fill="url(#gradWC)" />
        <!-- top arches -->
        <path d="M118 80 v-22 a17 17 0 0 1 34 0 v22 M148 80 v-22 a17 17 0 0 1 34 0 v22" stroke="rgba(244,239,230,0.65)" stroke-width="0.8" />
        <!-- horizontal grid -->
        <g stroke="rgba(244,239,230,0.18)" stroke-width="0.5">
          <line x1="115" y1="115" x2="185" y2="115" />
          <line x1="115" y1="150" x2="185" y2="115" />
          <line x1="115" y1="185" x2="185" y2="185" />
          <line x1="115" y1="220" x2="185" y2="220" />
          <line x1="115" y1="150" x2="185" y2="150" />
        </g>

        <!-- airflow arrows (cool air in, warm out) -->
        <g stroke="rgba(184, 69, 31, 0.85)" stroke-width="1" fill="none" stroke-linecap="round">
          <!-- warm air rising -->
          <path d="M150 250 q-2 -25 -8 -50 q-3 -20 -2 -60" />
          <polygon points="138,90 142,80 146,90" fill="rgba(184, 69, 31, 0.85)" stroke="none" />
          <path d="M152 250 q2 -25 8 -50 q3 -20 2 -60" />
          <polygon points="158,90 162,80 166,90" fill="rgba(184, 69, 31, 0.85)" stroke="none" />
        </g>

        <g stroke="rgba(198, 183, 154, 0.9)" stroke-width="1" fill="none" stroke-linecap="round">
          <!-- cool air entering -->
          <path d="M40 340 q40 -10 70 -5" />
          <polygon points="105,332 115,335 105,340" fill="rgba(198, 183, 154, 0.9)" stroke="none" />
          <path d="M260 340 q-40 -10 -70 -5" />
          <polygon points="195,332 185,335 195,340" fill="rgba(198, 183, 154, 0.9)" stroke="none" />
        </g>

        <!-- label dots -->
        <circle cx="150" cy="58" r="2" fill="rgba(244,239,230,0.8)" />
        <text x="158" y="62" fill="rgba(244,239,230,0.65)" font-family="Inter Variable, sans-serif" font-size="9">bâdgir</text>
        <circle cx="60" cy="340" r="2" fill="rgba(198, 183, 154, 0.95)" />
        <text x="14" y="332" fill="rgba(198, 183, 154, 0.85)" font-family="Inter Variable, sans-serif" font-size="9">cool air</text>
        <circle cx="156" cy="160" r="2" fill="rgba(184, 69, 31, 0.85)" />
        <text x="165" y="164" fill="rgba(184, 69, 31, 0.85)" font-family="Inter Variable, sans-serif" font-size="9">warm air</text>
      </svg>
    </div>
  </div>
</section>
