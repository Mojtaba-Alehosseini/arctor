---
import Mark from "./Mark.astro";
import { t, withBase, localePath, type Locale } from "../i18n/config";
import { site, softwareTools, languages } from "../lib/site";
import { projects } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="sheet pt-[calc(var(--header-h,4.5rem)+clamp(3rem,7vw,6rem))]">
  <div class="shell">
    <p class="label" style="opacity:.5" data-reveal><span class="reveal">{d.about.eyebrow}</span></p>
    <h1 class="t-h1 mt-6 measure" data-reveal><span class="reveal block">{d.about.title}</span></h1>
  </div>

  <div class="shell mt-14 grid gap-12 md:mt-20 md:grid-cols-12 md:gap-10">
    <figure class="md:col-span-4" data-reveal>
      <div class="plate aspect-[4/5]" style="background:var(--color-paper-2)">
        <img
          src={withBase("/portrait.jpg")}
          width="1000"
          height="1249"
          alt={site.name}
          class="reveal-img"
          decoding="async"
        />
      </div>
      <figcaption class="label mt-3" style="opacity:.45">{d.about.portraitCaption}</figcaption>

      <dl class="mt-10 space-y-8">
        <div>
          <dt class="label rule-b pb-2" style="opacity:.45">{d.about.languagesTitle}</dt>
          <dd>
            <ul class="mt-3 space-y-1.5">
              {
                languages.map((l) => (
                  <li class="flex items-baseline justify-between gap-4 text-[0.95rem]">
                    <span>{l.name}</span>
                    <span class="label" style="opacity:.45">{l.level}</span>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
        <div>
          <dt class="label rule-b pb-2" style="opacity:.45">{d.about.toolsTitle}</dt>
          <dd class="mt-3 flex flex-wrap gap-x-4 gap-y-1.5 text-[0.95rem]">
            {softwareTools.map((s) => <span>{s}</span>)}
          </dd>
        </div>
      </dl>

      <div class="mt-10 flex flex-col items-start gap-3">
        <a class="btn" href={withBase(site.cv)} download>{d.about.downloadCv}</a>
        <a class="btn" href={withBase(site.portfolio)} download>{d.about.downloadPortfolio}</a>
      </div>
    </figure>

    <div class="md:col-span-7 md:col-start-6">
      <p class="t-lead measure" data-reveal><span class="reveal block">{d.about.lead}</span></p>
      <div class="mt-8 space-y-6">
        {
          d.about.paras.map((p, i) => (
            <p class="t-body measure" data-reveal style={`--d:${i * 60}ms`}>
              <span class="reveal block">{p}</span>
            </p>
          ))
        }
      </div>

      <h2 class="label rule-b mt-16 pb-3" style="opacity:.45" data-reveal>
        <span class="reveal">{d.about.pathTitle}</span>
      </h2>
      <ol class="mt-2">
        {
          d.about.path.map((s, i) => (
            <li class="rule-b grid gap-2 py-6 sm:grid-cols-[8.5rem_1fr] sm:gap-8" data-reveal style={`--d:${i * 60}ms`}>
              <p class="num reveal pt-1 text-[0.82rem]" style="opacity:.5">{s.year}</p>
              <div class="reveal" style={`--d:${i * 60 + 50}ms`}>
                <h3 class="t-h3">{s.title}</h3>
                <p class="label mt-2" style="opacity:.5">{s.place}</p>
                <p class="t-body measure mt-3 text-[0.94rem]">{s.note}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>

  <!-- Her ten marks, as an index -->
  <div class="shell band-sm">
    <p class="label rule-b pb-3" style="opacity:.45" data-reveal><span class="reveal">{d.index.eyebrow}</span></p>
    <ul class="mt-8 grid grid-cols-5 gap-x-6 gap-y-10 sm:grid-cols-5 lg:grid-cols-10">
      {
        projects.map((p, i) => (
          <li data-reveal style={`--d:${i * 45}ms`}>
            <a href={localePath(locale, `/work/${p.slug}/`)} class="reveal block transition-opacity duration-300 hover:opacity-55">
              <Mark slug={p.slug} class="h-10 w-10" />
              <span class="num mt-3 block text-[0.7rem]" style="opacity:.4">{p.year}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
