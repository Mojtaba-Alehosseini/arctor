---
import { t, type Locale } from "../i18n/config";
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="relative bg-[var(--color-travertine)] text-[var(--color-ink)] py-32 sm:py-48">
  <div class="container-edge max-w-5xl">
    <p class="text-eyebrow opacity-60 mb-12">{dict.manifesto.eyebrow} — 02 / 06</p>
    <div class="reveal-trigger">
      {dict.manifesto.lines.map((line, i) => (
        <span class="reveal-mask block" style={`--reveal-delay: ${i * 100}ms`}>
          <span class="reveal-line text-display text-[clamp(1.6rem,4vw,3.5rem)] leading-[1.18] block">
            {line}
          </span>
        </span>
      ))}
    </div>
    <p class="mt-16 text-eyebrow opacity-60">{dict.manifesto.signature}</p>
  </div>
</section>
