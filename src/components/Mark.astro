---
import { marks } from "../lib/marks";

interface Props {
  slug: string;
  class?: string;
  style?: string;
  label?: string;
}

const { slug, class: cls = "", style, label } = Astro.props;
const m = marks[slug];
---

{
  m && (
    <svg
      class={`mark ${cls}`}
      style={style}
      viewBox={m.vb}
      fill="currentColor"
      preserveAspectRatio="xMidYMid meet"
      role={label ? "img" : "presentation"}
      aria-label={label}
      aria-hidden={label ? undefined : "true"}
    >
      <path fill-rule="evenodd" d={m.d} />
    </svg>
  )
}
