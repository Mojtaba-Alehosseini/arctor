  <!-- Stylised "A" with a windcatcher slot — the Arctor mark -->
  <path d="M6 26 L16 4 L26 26" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
  <path d="M12 18 L20 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
  <path d="M16 8 L16 14" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="1 2" />
</svg>
