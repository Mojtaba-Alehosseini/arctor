---
import { t, type Locale, localePath } from "../i18n/config";
import HeroCanvas from "./HeroCanvas.tsx";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
---

<section class="relative min-h-[100svh] w-full grain overflow-hidden bg-[var(--color-ink)] text-[var(--color-travertine)]">
  <HeroCanvas client:load />

  <div class="relative container-edge pt-28 sm:pt-32 pb-12 min-h-[100svh] flex flex-col">
    <!-- top eyebrow -->
    <div class="flex items-start justify-between text-eyebrow opacity-70 mb-12 sm:mb-20">
      <p>{dict.hero.eyebrow}</p>
      <p class="hidden sm:block">{dict.hero.counterLabel} · 01 / 06</p>
    </div>

    <!-- headline -->
    <div class="reveal-trigger">
      <h1 class="text-display text-[clamp(1.75rem,5vw,4.5rem)] leading-[1.06] tracking-tight">
        {dict.hero.headlineLines.map((line, i) => (
          <span class="reveal-mask block" style={`--reveal-delay: ${i * 90}ms`}>
            <span class="reveal-line">{line}</span>
          </span>
        ))}
      </h1>

      <p class="mt-6 sm:mt-8 max-w-[44ch] text-sm sm:text-base opacity-80 leading-relaxed">
        {dict.hero.intro}
      </p>

      <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-6">
        <a
          href={localePath(locale, "work")}
          class="group inline-flex items-center gap-3 text-eyebrow link-underline"
        >
          <span>{dict.hero.cta}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={localePath(locale, "contact")}
          class="text-eyebrow opacity-60 hover:opacity-100 transition-opacity link-underline"
        >
          {dict.nav.contact}
        </a>
      </div>
    </div>

    <!-- bottom row -->
    <div class="mt-auto pt-12 flex items-end justify-between text-eyebrow opacity-60">
      <p>{dict.hero.scrollHint} ↓</p>
      <p class="hidden sm:block">N. 1 / 6 — Genoa · 44°24′N · 8°56′E</p>
    </div>
  </div>
</section>
