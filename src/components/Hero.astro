---
import Mark from "./Mark.astro";
import { t, localePath, withBase, type Locale } from "../i18n/config";
import { site } from "../lib/site";
import { projects } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const lead = projects[0];
---

<section class="sheet relative overflow-hidden pt-[calc(var(--header-h,4.5rem)+clamp(2.5rem,7vw,6rem))]">
  <div class="shell">
    <!-- top meta rail -->
    <div
      class="rule-b flex flex-wrap items-baseline justify-between gap-x-8 gap-y-2 pb-4"
      data-reveal
    >
      <p class="label reveal" style="--d:0ms">
        <span style="color:var(--color-brass)">●</span>
        <span class="ml-2">{d.hero.availability}</span>
      </p>
      <p class="label reveal" style="--d:60ms;opacity:.5">
        {site.city}, {site.country} · <span class="num">{site.coords}</span>
      </p>
    </div>

    <!-- headline -->
    <h1 class="t-display mt-8 md:mt-12" data-reveal>
      {
        d.hero.headline.map((line, i) => (
          <span class="block overflow-hidden">
            <span class="reveal block" style={`--d:${90 + i * 90}ms`}>
              {i % 2 === 1 ? <em class="not-italic" style="color:var(--muted)">{line}</em> : line}
            </span>
          </span>
        ))
      }
    </h1>

    <div class="mt-10 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-8" data-reveal>
      <div class="md:col-span-5 md:col-start-1">
        <p class="t-lead measure reveal" style="--d:120ms">{d.hero.intro}</p>
        <div class="mt-8 flex flex-wrap items-center gap-3 reveal" style="--d:190ms">
          <a class="btn btn-solid" href={localePath(locale, "/work/")}>
            {d.hero.ctaWork}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href={localePath(locale, "/contact/")}>{d.hero.ctaContact}</a>
        </div>
      </div>

      <div class="md:col-span-4 md:col-start-9">
        <dl class="reveal grid grid-cols-2 gap-x-6 gap-y-5" style="--d:240ms">
          <div>
            <dt class="label" style="opacity:.45">{d.work.roleLabel}</dt>
            <dd class="mt-1.5 text-[0.95rem] leading-snug">{d.hero.role}</dd>
          </div>
          <div>
            <dt class="label" style="opacity:.45">{d.about.languagesTitle}</dt>
            <dd class="num mt-1.5 text-[0.95rem] leading-snug">FA · EN · AR · IT</dd>
          </div>
        </dl>
      </div>
    </div>
  </div>

  <!-- lead image -->
  <div class="shell-wide mt-14 md:mt-20">
    <a
      href={localePath(locale, `/work/${lead.slug}/`)}
      class="plate plate-zoom group block aspect-[16/10] w-full md:aspect-[21/9]"
      style={`background:${lead.cover.bg}`}
      data-reveal
    >
      <img
        src={withBase(`/images/${lead.slug}/${lead.cover.src}`)}
        width={lead.cover.w}
        height={lead.cover.h}
        alt=""
        fetchpriority="high"
        decoding="async"
        class="reveal-img"
      />
      <div
        class="pointer-events-none absolute inset-0"
        style="background:linear-gradient(to top, rgb(20 23 15 / .55), rgb(20 23 15 / .05) 42%, transparent 70%)"
      >
      </div>
      <div class="absolute inset-x-0 bottom-0 p-[var(--gutter)]" style="color:#f0ece2">
        <div class="flex items-end justify-between gap-6">
          <div class="flex items-end gap-4">
            <Mark slug={lead.slug} class="hidden h-10 w-10 shrink-0 opacity-90 sm:block" />
            <div>
              <p class="label mb-2.5" style="opacity:.75">
                <span class="num">{lead.year}</span> · {d.categories[lead.category]}
              </p>
              <p class="t-h3">{d.thesis.title}</p>
            </div>
          </div>
          <span class="label hidden shrink-0 items-center gap-2 sm:flex">
            {d.index.viewProject}
            <span class="arrow rtl-flip" aria-hidden="true">→</span>
          </span>
        </div>
      </div>
    </a>
  </div>
</section>
