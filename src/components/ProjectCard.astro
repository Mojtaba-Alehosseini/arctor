---
import type { Project } from "../data/projects";
import { t, type Locale, localePath, DEFAULT_LOCALE } from "../i18n/config";

interface Props { project: Project; locale: Locale; index: number }
const { project, locale, index } = Astro.props;
const d = t(locale);
const proj = project.i18n[locale] ?? project.i18n[DEFAULT_LOCALE];
const idx = String(index).padStart(2, "0");
---

<a
  href={localePath(locale, `work/${project.slug}`)}
  class="group block reveal-trigger relative isolate overflow-hidden"
  data-cursor="large"
>
  <article class="grid grid-cols-12 gap-x-6 sm:gap-x-10 gap-y-4 items-stretch py-10 sm:py-14 border-t border-[color-mix(in_oklab,var(--color-ink)_18%,transparent)]">
    <!-- left meta -->
    <div class="col-span-2 sm:col-span-1 text-eyebrow opacity-60">{idx}</div>
    <div class="col-span-10 sm:col-span-3 text-eyebrow opacity-60 space-y-1">
      <p>{project.category} · {project.yearShort}</p>
      <p>{project.location}</p>
    </div>

    <!-- title + sub -->
    <div class="col-span-12 sm:col-span-5 self-center">
      <h3 class="text-display text-[clamp(1.6rem,3.6vw,2.8rem)] leading-[1.05] transition-transform duration-700 ease-out group-hover:translate-x-2 reveal-mask">
        <span class="reveal-line">{proj.title}</span>
      </h3>
      <p class="mt-2 opacity-75 max-w-[44ch]">{proj.subtitle}</p>
    </div>

    <!-- thumbnail (reveals on hover) -->
    <div class="hidden sm:block col-span-3 self-stretch relative">
      <div class="absolute inset-0 aspect-[4/3] overflow-hidden bg-[var(--color-graphite)]">
        <img
          src={project.cover}
          alt=""
          class="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-[1.06]"
          loading="lazy"
          decoding="async"
        />
        <div class="absolute inset-0 bg-[var(--color-ink)] opacity-30 group-hover:opacity-0 transition-opacity duration-500"></div>
      </div>
    </div>
  </article>
</a>
