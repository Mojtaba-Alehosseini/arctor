---
import Mark from "./Mark.astro";
import { t, localePath, withBase, type Locale } from "../i18n/config";
import { projectCopy, type Project } from "../data/projects";

interface Props {
  locale: Locale;
  project: Project;
  index?: number;
  wide?: boolean;
}

const { locale, project: p, index = 0, wide = false } = Astro.props;
const d = t(locale);
const c = projectCopy(p.slug, locale);
const im = wide ? p.cover : p.card;
---

<a
  href={localePath(locale, `/work/${p.slug}/`)}
  class="group block"
  data-reveal
  style={`--d:${Math.min(index * 70, 280)}ms`}
>
  <div
    class={`plate plate-zoom ${wide ? "aspect-[16/10]" : "aspect-[4/5]"}`}
    style={`background:${im.bg}`}
  >
    <img
      src={withBase(`/images/${p.slug}/${im.src}`)}
      width={im.w}
      height={im.h}
      alt={c.title}
      loading={index < 2 ? "eager" : "lazy"}
      decoding="async"
      class="reveal-img"
    />
    <span
      class="absolute top-4 left-4 flex h-9 w-9 items-center justify-center rounded-full backdrop-blur-md transition-opacity duration-500 group-hover:opacity-100 md:opacity-0"
      style="background:color-mix(in oklab, var(--color-paper) 78%, transparent)"
      aria-hidden="true"
    >
      <Mark slug={p.slug} class="h-4 w-4" style="color:var(--color-ink)" />
    </span>
  </div>

  <div class="mt-4 flex items-start justify-between gap-5">
    <div class="min-w-0">
      <h3 class="t-h3 text-balance">{c.title}</h3>
      <p class="t-body mt-1.5 line-clamp-2 text-[0.9rem] leading-snug">{c.subtitle}</p>
    </div>
    <div class="shrink-0 text-right">
      <p class="num text-[0.8rem]" style="opacity:.55">{p.year}</p>
      <p class="label mt-1" style="opacity:.4">{d.categories[p.category]}</p>
    </div>
  </div>
</a>
