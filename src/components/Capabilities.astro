---
import { t, type Locale } from "../i18n/config";
interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const items = dict.capabilities.items;
const ribbon = [...items, ...items];
---

<section class="bg-[var(--color-travertine)] text-[var(--color-ink)] py-24 sm:py-32 border-t border-[color-mix(in_oklab,var(--color-ink)_15%,transparent)]">
  <div class="container-edge mb-12">
    <p class="text-eyebrow opacity-60 mb-4">{dict.capabilities.eyebrow} — 05 / 06</p>
    <h2 class="text-display text-[clamp(2rem,4.5vw,3.5rem)] leading-[1.05] max-w-[24ch]">{dict.capabilities.title}</h2>
  </div>
  <div class="marquee">
    <div class="marquee__inner">
      {ribbon.map((item) => (
        <span class="text-display text-[clamp(2rem,5vw,4rem)] leading-none whitespace-nowrap flex items-center gap-12">
          <span>{item}</span>
          <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
            <circle cx="7" cy="7" r="3" fill="currentColor" opacity="0.4" />
          </svg>
        </span>
      ))}
    </div>
  </div>
</section>
