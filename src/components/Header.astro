---
import Mark from "./Mark.astro";
import {
  t,
  localePath,
  LOCALES,
  LOCALE_SHORT,
  LOCALE_LABELS,
  type Locale,
} from "../i18n/config";
import { site } from "../lib/site";

interface Props {
  locale: Locale;
  pathname?: string;
}

const { locale, pathname = "/" } = Astro.props;
const d = t(locale);

const nav = [
  { href: "/work/", label: d.nav.work, match: "/work" },
  { href: "/about/", label: d.nav.about, match: "/about" },
  { href: "/services/", label: d.nav.practice, match: "/services" },
  { href: "/contact/", label: d.nav.contact, match: "/contact" },
];

const isActive = (m: string) => pathname === m || pathname.startsWith(m + "/");
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-50 transition-transform duration-500 will-change-transform"
  data-header
>
  <div
    class="pointer-events-none absolute inset-0 -z-10 opacity-0 transition-opacity duration-400"
    data-header-veil
    style="background:color-mix(in oklab, var(--color-paper) 82%, transparent);backdrop-filter:saturate(1.4) blur(14px);-webkit-backdrop-filter:saturate(1.4) blur(14px);border-bottom:1px solid var(--rule-soft)"
  >
  </div>

  <div class="shell flex h-[var(--header-h,4.5rem)] items-center justify-between gap-6">
    <a
      href={localePath(locale, "/")}
      class="group flex items-center gap-2.5"
      aria-label={site.name}
    >
      <Mark slug="monogram" class="h-[1.35rem] w-auto transition-transform duration-500 group-hover:rotate-[-4deg]" />
      <span class="label hidden sm:block">{site.name}</span>
    </a>

    <nav class="hidden items-center gap-8 md:flex" aria-label={d.nav.primary}>
      {
        nav.map((n) => (
          <a
            href={localePath(locale, n.href)}
            class="label link-grow py-1"
            style={isActive(n.match) ? "opacity:1" : "opacity:.62"}
            aria-current={isActive(n.match) ? "page" : undefined}
          >
            {n.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-4">
      <div class="hidden items-center gap-1 sm:flex" role="group" aria-label={d.nav.language}>
        {
          LOCALES.map((l) => (
            <a
              href={localePath(l, pathname)}
              hreflang={l}
              title={LOCALE_LABELS[l]}
              class="label px-1 py-1 transition-opacity duration-200 hover:opacity-100"
              style={l === locale ? "opacity:1;color:var(--color-brass)" : "opacity:.62"}
              aria-current={l === locale ? "true" : undefined}
            >
              {LOCALE_SHORT[l]}
            </a>
          ))
        }
      </div>

      <button
        type="button"
        class="label -mr-1 flex items-center gap-2 py-2 md:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
        data-label-open={d.nav.menu}
        data-label-close={d.nav.close}
      >
        <span data-menu-label>{d.nav.menu}</span>
        <span class="relative block h-[9px] w-4" aria-hidden="true">
          <span class="absolute inset-x-0 top-0 h-px bg-current transition-transform duration-300" data-bar="1"></span>
          <span class="absolute inset-x-0 bottom-0 h-px bg-current transition-transform duration-300" data-bar="2"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<div
  id="mobile-menu"
  class="fixed inset-0 z-40 hidden flex-col justify-between md:!hidden"
  data-menu-panel
  style="background:var(--color-paper)"
>
  <div class="h-[var(--header-h,4.5rem)]"></div>
  <nav class="shell flex flex-1 flex-col justify-center gap-2 pb-10" aria-label={d.nav.menu}>
    {
      nav.map((n, i) => (
        <a
          href={localePath(locale, n.href)}
          class="t-h1 block py-2"
          style={`--d:${60 + i * 45}ms`}
          data-menu-item
        >
          {n.label}
        </a>
      ))
    }
  </nav>
  <div class="shell rule-t flex flex-wrap items-center justify-between gap-4 py-6">
    <div class="flex items-center gap-3">
      {
        LOCALES.map((l) => (
          <a
            href={localePath(l, pathname)}
            hreflang={l}
            class="label"
            style={l === locale ? "opacity:1;color:var(--color-brass)" : "opacity:.62"}
          >
            {LOCALE_SHORT[l]}
          </a>
        ))
      }
    </div>
    <a href={`mailto:${site.email}`} class="label link">{site.email}</a>
  </div>
</div>

<script is:inline>
  (function () {
    var header = document.querySelector("[data-header]");
    var veil = document.querySelector("[data-header-veil]");
    if (!header) return;

    var last = window.scrollY;
    var hidden = false;
    var ticking = false;

    function onScroll() {
      var y = window.scrollY;
      if (veil) veil.style.opacity = y > 24 ? "1" : "0";

      var menuOpen = document.documentElement.hasAttribute("data-menu-open");
      if (!menuOpen) {
        var goingDown = y > last && y > 220;
        if (goingDown !== hidden) {
          hidden = goingDown;
          header.style.transform = hidden ? "translateY(-102%)" : "translateY(0)";
        }
      }
      last = y;
      ticking = false;
    }

    addEventListener(
      "scroll",
      function () {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );
    onScroll();

    /* Mobile menu */
    var toggle = document.querySelector("[data-menu-toggle]");
    var panel = document.querySelector("[data-menu-panel]");
    var labelEl = document.querySelector("[data-menu-label]");
    var bar1 = document.querySelector('[data-bar="1"]');
    var bar2 = document.querySelector('[data-bar="2"]');
    if (!toggle || !panel) return;

    var open = false;
    var labelOpen = toggle.getAttribute("data-label-open") || "Menu";
    var labelClose = toggle.getAttribute("data-label-close") || "Close";
    var main = document.getElementById("main");
    var footer = document.querySelector("footer");

    function setOpen(next) {
      open = next;
      toggle.setAttribute("aria-expanded", String(open));
      if (labelEl) labelEl.textContent = open ? labelClose : labelOpen;
      panel.setAttribute("aria-hidden", String(!open));
      // Keep the rest of the page out of the tab order while the sheet is up.
      [main, footer].forEach(function (el) {
        if (!el) return;
        if (open) el.setAttribute("inert", "");
        else el.removeAttribute("inert");
      });
      document.documentElement.toggleAttribute("data-menu-open", open);
      document.body.style.overflow = open ? "hidden" : "";
      if (bar1 && bar2) {
        bar1.style.transform = open ? "translateY(4px) rotate(45deg)" : "";
        bar2.style.transform = open ? "translateY(-4px) rotate(-45deg)" : "";
      }
      if (open) {
        panel.style.display = "flex";
        panel.animate(
          [
            { opacity: 0, transform: "translateY(-8px)" },
            { opacity: 1, transform: "translateY(0)" },
          ],
          { duration: 260, easing: "cubic-bezier(0.23,1,0.32,1)", fill: "both" }
        );
        panel.querySelectorAll("[data-menu-item]").forEach(function (el, i) {
          el.animate(
            [
              { opacity: 0, transform: "translateY(14px)" },
              { opacity: 1, transform: "translateY(0)" },
            ],
            { duration: 460, delay: 60 + i * 45, easing: "cubic-bezier(0.23,1,0.32,1)", fill: "both" }
          );
        });
        var first = panel.querySelector("a");
        if (first) first.focus({ preventScroll: true });
      } else {
        var a = panel.animate([{ opacity: 1 }, { opacity: 0 }], {
          duration: 180,
          easing: "cubic-bezier(0.23,1,0.32,1)",
          fill: "both",
        });
        a.finished.then(function () {
          if (!open) panel.style.display = "none";
        });
      }
    }

    toggle.addEventListener("click", function () {
      setOpen(!open);
    });
    addEventListener("keydown", function (e) {
      if (e.key === "Escape" && open) {
        setOpen(false);
        toggle.focus({ preventScroll: true });
      }
    });
  })();
</script>
