---
import Mark from "./Mark.astro";
import { t, localePath, withBase, type Locale } from "../i18n/config";
import { site } from "../lib/site";
import { projects } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const year = new Date().getFullYear();
---

<footer class="on-ink grain relative overflow-hidden">
  <div class="shell band-sm">
    <!-- Mark strip: her ten project glyphs -->
    <div class="marquee mb-14 md:mb-20" style="--speed:64s" aria-hidden="true">
      <div class="marquee__track">
        {projects.map((p) => <Mark slug={p.slug} class="h-7 w-7 shrink-0 opacity-30 md:h-9 md:w-9" />)}
      </div>
      <div class="marquee__track">
        {projects.map((p) => <Mark slug={p.slug} class="h-7 w-7 shrink-0 opacity-30 md:h-9 md:w-9" />)}
      </div>
    </div>

    <div class="grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-5">
        <a href={localePath(locale, "/")} class="inline-flex items-center gap-3">
          <Mark slug="monogram" class="h-8 w-auto" />
          <span class="t-h3">{site.name}</span>
        </a>
        <p class="label mt-4" style="opacity:.55">{d.footer.tagline}</p>
        <p class="t-body measure-sm mt-6">{d.cta.body}</p>
      </div>

      <nav class="md:col-span-3" aria-label="Footer">
        <p class="label mb-5" style="opacity:.45">{d.index.counter}</p>
        <ul class="space-y-2.5">
          <li><a class="link-grow" href={localePath(locale, "/work/")}>{d.nav.work}</a></li>
          <li><a class="link-grow" href={localePath(locale, "/about/")}>{d.nav.about}</a></li>
          <li><a class="link-grow" href={localePath(locale, "/services/")}>{d.nav.practice}</a></li>
          <li><a class="link-grow" href={localePath(locale, "/contact/")}>{d.nav.contact}</a></li>
        </ul>
      </nav>

      <div class="md:col-span-4">
        <p class="label mb-5" style="opacity:.45">{d.contact.eyebrow}</p>
        <ul class="space-y-2.5">
          <li><a class="link-grow break-all" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="link-grow" href={`tel:${site.phoneHref}`} dir="ltr">{site.phone}</a></li>
          <li class="pt-1" style="color:var(--muted)">{site.city}, {site.country}</li>
        </ul>
        <div class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a class="label link-grow" href={withBase(site.cv)} download>{d.about.downloadCv}</a>
          <a class="label link-grow" href={withBase(site.portfolio)} download>{d.about.downloadPortfolio}</a>
        </div>
      </div>
    </div>

    <div class="rule-t mt-16 flex flex-col gap-4 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="label" style="opacity:.45">© {year} {site.name}</p>
      <p class="label hidden lg:block" style="opacity:.32">{d.footer.colophon}</p>
      <a href="#main" class="label link-grow" style="opacity:.6">{d.footer.backToTop} ↑</a>
    </div>
  </div>
</footer>
