---
import { t, type Locale } from "../i18n/config";
import { softwareTools } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="sheet pt-[calc(var(--header-h,4.5rem)+clamp(3rem,7vw,6rem))]">
  <div class="shell">
    <p class="label" style="opacity:.5" data-reveal><span class="reveal">{d.practice.eyebrow}</span></p>
    <h1 class="t-h1 mt-6 measure" data-reveal><span class="reveal block">{d.practice.title}</span></h1>
    <p class="t-lead measure mt-6" data-reveal><span class="reveal block">{d.practice.lead}</span></p>
  </div>

  <div class="shell mt-16 md:mt-24">
    <ol>
      {
        d.practice.items.map((s, i) => (
          <li class="rule-t grid gap-4 py-9 md:grid-cols-12 md:gap-8" data-reveal style={`--d:${i * 80}ms`}>
            <p class="num reveal text-[0.8rem] md:col-span-1" style="opacity:.4">{s.n}</p>
            <h2 class="t-h2 reveal md:col-span-5" style={`--d:${i * 80 + 40}ms`}>{s.name}</h2>
            <p class="t-body reveal md:col-span-5 md:col-start-8" style={`--d:${i * 80 + 90}ms`}>{s.body}</p>
          </li>
        ))
      }
      <li class="rule-t"></li>
    </ol>
  </div>
</section>

<section class="band-sm" style="background:var(--color-paper-2)">
  <div class="shell grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-4" data-reveal>
      <h2 class="t-h2 reveal">{d.practice.processTitle}</h2>
    </div>
    <ol class="md:col-span-7 md:col-start-6">
      {
        d.practice.process.map((s, i) => (
          <li class="rule-t flex items-baseline gap-6 py-5" data-reveal style={`--d:${i * 60}ms`}>
            <span class="num reveal text-[0.78rem]" style="opacity:.4">{s.n}</span>
            <span class="reveal min-w-0 flex-1" style={`--d:${i * 60 + 40}ms`}>
              <span class="t-h3 block">{s.name}</span>
              <span class="t-body mt-1 block text-[0.92rem]">{s.body}</span>
            </span>
          </li>
        ))
      }
      <li class="rule-t"></li>
    </ol>
  </div>
</section>

<section class="sheet band-sm">
  <div class="shell grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5" data-reveal>
      <h2 class="label rule-b pb-3" style="opacity:.45"><span class="reveal">{d.practice.skillsTitle}</span></h2>
      <ul class="mt-5 space-y-2">
        {
          d.practice.skills.map((s, i) => (
            <li class="t-h3" data-reveal style={`--d:${i * 60}ms`}>
              <span class="reveal block">{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="md:col-span-5 md:col-start-8" data-reveal>
      <h2 class="label rule-b pb-3" style="opacity:.45"><span class="reveal">{d.practice.toolsTitle}</span></h2>
      <ul class="mt-5 space-y-2">
        {
          softwareTools.map((s, i) => (
            <li class="t-h3" data-reveal style={`--d:${i * 50}ms`}>
              <span class="reveal block">{s}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
