---
import ProjectCard from "./ProjectCard.astro";
import { t, localePath, type Locale } from "../i18n/config";
import { featuredProjects } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
const items = featuredProjects.filter((p) => p.slug !== "house-of-future");
---

<section class="sheet band-sm">
  <div class="shell">
    <div class="mb-10 flex flex-wrap items-end justify-between gap-6 md:mb-14" data-reveal>
      <h2 class="t-h2 reveal measure-sm">{d.index.eyebrow}</h2>
      <a class="label link-grow reveal" style="--d:60ms" href={localePath(locale, "/work/")}>
        {d.index.viewAll} →
      </a>
    </div>

    <div class="grid gap-x-6 gap-y-14 sm:grid-cols-2 lg:grid-cols-4">
      {items.map((p, i) => <ProjectCard locale={locale} project={p} index={i} />)}
    </div>
  </div>
</section>
