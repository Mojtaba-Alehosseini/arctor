---
import { featuredProjects } from "../data/projects";
import { t, type Locale, localePath } from "../i18n/config";
import ProjectCard from "./ProjectCard.astro";

interface Props { locale: Locale }
const { locale } = Astro.props;
const dict = t(locale);
const list = featuredProjects();
---

<section class="bg-[var(--color-travertine)] text-[var(--color-ink)] pt-24 sm:pt-32 pb-12">
  <div class="container-edge">
    <div class="flex items-end justify-between mb-10">
      <div>
        <p class="text-eyebrow opacity-60 mb-4">{dict.featured.eyebrow} — 04 / 06</p>
        <h2 class="text-display text-[clamp(2rem,5vw,4rem)] leading-[1.05] max-w-[20ch]">
          {dict.featured.title}
        </h2>
      </div>
      <a href={localePath(locale, "work")} class="hidden sm:inline-flex items-center gap-3 text-eyebrow link-underline">
        <span>{dict.featured.viewAll}</span><span aria-hidden="true">→</span>
      </a>
    </div>
    <div>
      {list.map((p, i) => (
        <ProjectCard project={p} locale={locale} index={i + 1} />
      ))}
    </div>
  </div>
</section>
