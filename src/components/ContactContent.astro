---
import Mark from "./Mark.astro";
import { t, withBase, type Locale } from "../i18n/config";
import { site } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);

const rows = [
  { label: d.contact.emailLabel, value: site.email, href: `mailto:${site.email}`, copy: true },
  { label: d.contact.phoneLabel, value: site.phone, href: `tel:${site.phoneHref}`, copy: true, ltr: true },
  { label: d.contact.locationLabel, value: d.contact.locationValue },
];
---

<section class="sheet pt-[calc(var(--header-h,4.5rem)+clamp(3rem,7vw,6rem))]">
  <div class="shell">
    <p class="label" style="opacity:.5" data-reveal><span class="reveal">{d.contact.eyebrow}</span></p>
    <h1 class="t-display mt-6" data-reveal><span class="reveal block">{d.contact.title}</span></h1>
    <p class="t-lead measure mt-8" data-reveal><span class="reveal block">{d.contact.body}</span></p>
  </div>

  <div class="shell mt-14 grid gap-12 md:mt-20 md:grid-cols-12 md:gap-10">
    <dl class="md:col-span-7">
      {
        rows.map((r, i) => (
          <div class="rule-t grid gap-1 py-6 sm:grid-cols-[9rem_1fr] sm:gap-8" data-reveal style={`--d:${i * 70}ms`}>
            <dt class="label reveal pt-1.5" style="opacity:.45">{r.label}</dt>
            <dd class="reveal flex flex-wrap items-baseline gap-x-5 gap-y-1" style={`--d:${i * 70 + 40}ms`}>
              {r.href ? (
                <a class="t-h3 link-grow break-all" href={r.href} dir={r.ltr ? "ltr" : undefined}>
                  {r.value}
                </a>
              ) : (
                <span class="t-h3">{r.value}</span>
              )}
              {r.copy && (
                <button
                  type="button"
                  class="label shrink-0"
                  style="opacity:.42"
                  data-copy={r.value}
                  data-copied-label={d.contact.copied}
                >
                  <span data-copy-label>{d.contact.copy}</span>
                </button>
              )}
            </dd>
          </div>
        ))
      }
      <div class="rule-t grid gap-1 py-6 sm:grid-cols-[9rem_1fr] sm:gap-8" data-reveal>
        <dt class="label reveal pt-1.5" style="opacity:.45">{d.contact.cvLabel}</dt>
        <dd class="reveal" style="--d:40ms">
          <a class="t-h3 link-grow" href={withBase(site.cv)} download>{d.about.downloadCv}</a>
          <p class="label mt-1.5" style="opacity:.4">{d.contact.cvValue}</p>
        </dd>
      </div>
      <div class="rule-t grid gap-1 py-6 sm:grid-cols-[9rem_1fr] sm:gap-8" data-reveal>
        <dt class="label reveal pt-1.5" style="opacity:.45">{d.contact.portfolioLabel}</dt>
        <dd class="reveal" style="--d:40ms">
          <a class="t-h3 link-grow" href={withBase(site.portfolio)} download>{d.about.downloadPortfolio}</a>
          <p class="label mt-1.5" style="opacity:.4">{d.contact.portfolioValue}</p>
        </dd>
      </div>
      <div class="rule-t"></div>
    </dl>

    <div class="md:col-span-4 md:col-start-9" data-reveal>
      <a
        class="btn btn-solid reveal w-full justify-center"
        href={`mailto:${site.email}?subject=${encodeURIComponent("Project enquiry — " + site.name)}`}
      >
        {d.cta.button}
        <span class="arrow" aria-hidden="true">→</span>
      </a>
      <div class="reveal mt-14 w-28" style="--d:160ms">
        <Mark slug="shams-tomb" class="h-28 w-28" style="opacity:.09" />
      </div>
    </div>
  </div>
</section>

<script is:inline>
  (function () {
    document.querySelectorAll("[data-copy]").forEach(function (btn) {
      btn.addEventListener("click", function () {
        var text = btn.getAttribute("data-copy") || "";
        var label = btn.querySelector("[data-copy-label]");
        var done = btn.getAttribute("data-copied-label") || "✓";
        navigator.clipboard &&
          navigator.clipboard.writeText(text).then(function () {
            if (!label) return;
            var prev = label.textContent;
            label.textContent = done;
            btn.style.opacity = "1";
            setTimeout(function () {
              label.textContent = prev;
              btn.style.opacity = "";
            }, 1600);
          });
      });
    });
  })();
</script>
