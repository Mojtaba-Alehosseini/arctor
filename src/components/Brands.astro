---
import { t, type Locale } from "../i18n/config";
import { brands } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="band-sm" style="background:var(--color-paper-2)">
  <div class="shell">
    <div class="grid gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4" data-reveal>
        <p class="label reveal" style="opacity:.62">{d.brands.eyebrow}</p>
        <h2 class="t-h2 reveal mt-4" style="--d:60ms">{d.brands.title}</h2>
        <p class="t-body reveal measure-sm mt-6" style="--d:110ms">{d.brands.note}</p>
      </div>
      <ul class="md:col-span-7 md:col-start-6">
        {
          brands.map((b, i) => (
            <li class="rule-t flex items-baseline justify-between gap-6 py-4" data-reveal style={`--d:${i * 60}ms`}>
              <span class="reveal t-h3">{b}</span>
              <span class="reveal num text-[0.75rem]" style={`--d:${i * 60 + 40}ms;opacity:.62`}>
                {String(i + 1).padStart(2, "0")}
              </span>
            </li>
          ))
        }
        <li class="rule-t"></li>
      </ul>
    </div>
  </div>
</section>
