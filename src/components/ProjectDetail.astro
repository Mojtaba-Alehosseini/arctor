---
import Mark from "./Mark.astro";
import AirflowDiagram from "./AirflowDiagram.astro";
import { t, localePath, withBase, type Locale } from "../i18n/config";
import { projectCopy, neighbours, type Project } from "../data/projects";

interface Props {
  locale: Locale;
  project: Project;
}

const { locale, project: p } = Astro.props;
const d = t(locale);
const c = projectCopy(p.slug, locale);
const { prev, next } = neighbours(p.slug);
const prevCopy = projectCopy(prev.slug, locale);
const nextCopy = projectCopy(next.slug, locale);

const facts = [
  { label: d.work.yearLabel, value: p.year },
  { label: d.work.categoryLabel, value: d.categories[p.category] },
  { label: d.work.placeLabel, value: p.place },
  { label: d.work.roleLabel, value: p.role },
  { label: d.work.scopeLabel, value: p.scope },
  { label: d.work.toolsLabel, value: p.tools.join(" · ") },
];
---

<article>
  <!-- ── Header ─────────────────────────────────────────────────────── -->
  <header class="sheet pt-[calc(var(--header-h,4.5rem)+clamp(2.5rem,6vw,5rem))]">
    <div class="shell">
      <a class="label link-grow" style="opacity:.62" href={localePath(locale, "/work/")}>
        <span class="rtl-flip inline-block" aria-hidden="true">←</span>
        <span class="ms-2">{d.work.backToWork}</span>
      </a>

      <div class="mt-10 flex items-start gap-6 md:mt-14 md:gap-9" data-reveal>
        <Mark slug={p.slug} class="reveal mt-2 hidden h-16 w-16 shrink-0 sm:block md:h-24 md:w-24" />
        <div class="min-w-0">
          <p class="label reveal" style="opacity:.62">
            <span class="num">{String(p.order).padStart(2, "0")}</span> · {d.categories[p.category]} ·
            <span class="num">{p.year}</span>
          </p>
          <h1 class="t-h1 reveal mt-4" style="--d:60ms">{c.title}</h1>
          <p class="t-lead reveal measure mt-5" style="--d:110ms">{c.subtitle}</p>
        </div>
      </div>
    </div>
  </header>

  <!-- ── Cover ──────────────────────────────────────────────────────── -->
  <div class="shell-wide mt-12 md:mt-16">
    <div class="plate aspect-[16/10] md:aspect-[21/9]" style={`background:${p.cover.bg}`} data-reveal>
      <img
        src={withBase(`/images/${p.slug}/${p.cover.src}`)}
        width={p.cover.w}
        height={p.cover.h}
        alt={c.title}
        fetchpriority="high"
        decoding="async"
        class="reveal-img"
      />
    </div>
  </div>

  <!-- ── Facts + narrative ──────────────────────────────────────────── -->
  <div class="sheet band-sm">
    <div class="shell grid gap-12 md:grid-cols-12 md:gap-10">
      <dl class="md:col-span-4">
        {
          facts.map((f, i) => (
            <div class="rule-t py-4" data-reveal style={`--d:${i * 50}ms`}>
              <dt class="label reveal" style="opacity:.62">{f.label}</dt>
              <dd class="reveal mt-1.5 text-[0.95rem] leading-snug" style={`--d:${i * 50 + 40}ms`}>{f.value}</dd>
            </div>
          ))
        }
        <div class="rule-t"></div>
      </dl>

      <div class="md:col-span-7 md:col-start-6">
        <p class="t-h3 measure" data-reveal><span class="reveal block">{c.brief}</span></p>
        <div class="mt-8 space-y-6">
          {
            c.body.map((para, i) => (
              <p class="t-body measure" data-reveal style={`--d:${i * 60}ms`}>
                <span class="reveal block">{para}</span>
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>

  {
    p.slug === "house-of-future" && (
      <section class="on-dark grain relative overflow-hidden">
        <div class="shell band-sm">
          <div class="flex flex-wrap items-end justify-between gap-6" data-reveal>
            <h2 class="t-h2 reveal">{d.thesis.diagram.title}</h2>
            <p class="label reveal measure-sm" style="--d:60ms;opacity:.62">{d.thesis.statLabel}</p>
          </div>
          <div class="reveal mt-12" data-reveal style="--d:120ms">
            <AirflowDiagram locale={locale} />
          </div>
        </div>
      </section>
    )
  }

  <!-- ── Portfolio plates ───────────────────────────────────────────── -->
  <section class="band-sm" style="background:var(--color-paper-2)">
    <div class="shell">
      <div class="rule-b flex flex-wrap items-baseline justify-between gap-4 pb-3" data-reveal>
        <h2 class="label reveal" style="opacity:.62">{d.work.platesLabel}</h2>
        <p class="label reveal" style="--d:50ms;opacity:.62">
          <span class="num">{String(p.plates.length).padStart(2, "0")}</span> · {d.work.platesNote}
        </p>
      </div>

      <div class="mt-10 space-y-8 md:space-y-14">
        {
          p.plates.map((pl, i) => (
            <figure class="plate" style={`background:${pl.bg}`} data-reveal>
              <img
                src={withBase(`/images/${p.slug}/${pl.src}`)}
                width={pl.w}
                height={pl.h}
                alt={`${c.title} — ${d.work.platesLabel} ${i + 1}`}
                loading={i < 1 ? "eager" : "lazy"}
                decoding="async"
                class="reveal-img w-full"
              />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ── Prev / next ────────────────────────────────────────────────── -->
  <nav class="sheet band-sm" aria-label={d.work.nextProject}>
    <div class="shell grid gap-6 md:grid-cols-2">
      <a
        href={localePath(locale, `/work/${prev.slug}/`)}
        class="group rule-t flex items-center gap-5 py-7 transition-opacity duration-300 hover:opacity-60"
        data-reveal
      >
        <span class="rtl-flip text-2xl leading-none" aria-hidden="true">←</span>
        <Mark slug={prev.slug} class="h-10 w-10 shrink-0 opacity-60" />
        <span class="min-w-0">
          <span class="label block" style="opacity:.62">{d.work.prevProject}</span>
          <span class="t-h3 mt-1 block truncate">{prevCopy.title}</span>
        </span>
      </a>
      <a
        href={localePath(locale, `/work/${next.slug}/`)}
        class="group rule-t flex flex-row-reverse items-center gap-5 py-7 text-end transition-opacity duration-300 hover:opacity-60"
        data-reveal
        style="--d:60ms"
      >
        <span class="rtl-flip text-2xl leading-none" aria-hidden="true">→</span>
        <Mark slug={next.slug} class="h-10 w-10 shrink-0 opacity-60" />
        <span class="min-w-0">
          <span class="label block" style="opacity:.62">{d.work.nextProject}</span>
          <span class="t-h3 mt-1 block truncate">{nextCopy.title}</span>
        </span>
      </a>
    </div>
  </nav>
</article>
