---
import Mark from "./Mark.astro";
import { t, localePath, type Locale } from "../i18n/config";
import { site } from "../lib/site";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const d = t(locale);
---

<section class="sheet band">
  <div class="shell">
    <div class="grid gap-10 md:grid-cols-12" data-reveal>
      <div class="md:col-span-8">
        <p class="label reveal" style="opacity:.62">{d.cta.eyebrow}</p>
        <h2 class="t-h1 reveal mt-6 measure">{d.cta.title}</h2>
        <p class="t-lead reveal measure mt-6" style="--d:80ms">{d.cta.body}</p>
        <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--d:140ms">
          <a class="btn btn-solid" href={localePath(locale, "/contact/")}>
            {d.cta.button}
            <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href={`mailto:${site.email}`}>{site.email}</a>
        </div>
      </div>
      <div class="hidden md:col-span-3 md:col-start-10 md:block">
        <div class="reveal ml-auto w-32" style="--d:200ms">
          <Mark slug="house-of-future" class="h-32 w-32" style="opacity:.085" />
        </div>
      </div>
    </div>
  </div>
</section>
